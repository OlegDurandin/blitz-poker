# Blitz Poker PvP server. Copy to .env (or a systemd EnvironmentFile) and fill in.
# Secrets live only on the server: never in the web bundle or in git.

# Address to listen on. Put it behind an HTTPS reverse proxy (Caddy, nginx).
PVP_BIND=127.0.0.1:8787

# Mini App id and its protected key ("Защищённый ключ"):
# vk.com/apps → Управление → приложение → Настройки.
VK_APP_ID=
VK_APP_SECRET=

# SQLite file with rooms and head-to-head scores.
PVP_DB=/var/lib/blitz-pvp/pvp.sqlite

# Page origins allowed to call the server. A leading dot allows every https
# subdomain (VK hosting is *.vk-apps.ru). Add http://localhost:5173 for local dev.
PVP_ALLOWED_ORIGINS=.vk-apps.ru,.vk-apps.com

# 1: players outside VK (the hosting URL opened in a browser) may join a room
# by its six-digit code as guests. They never host. Sign-ins and wrong codes
# are rate-limited per network (X-Forwarded-For from the reverse proxy).
PVP_GUEST_AUTH=0

# How long VK launch parameters stay valid (vk_ts), hours.
PVP_LAUNCH_MAX_AGE_HOURS=24

# Timers.
PVP_TURN_SECONDS=20
PVP_BANK_SECONDS=30
PVP_GRACE_SECONDS=60
PVP_ROOM_TTL_MINUTES=15

# Local development only: accept {"dev_user_id": N} without VK. Ignored unless
# PVP_BIND is a loopback address. Never enable in production.
PVP_DEV_AUTH=0
