{
  "name": "blitz-poker-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run wasm && vitest run",
    "tunnel": "npm run wasm && node scripts/vk.mjs tunnel",
    "predeploy": "npm run build",
    "deploy": "node scripts/vk.mjs deploy"
  },
  "dependencies": {
    "@vkontakte/vk-bridge": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vkontakte/vk-miniapps-deploy": "^1.0.3",
    "@vkontakte/vk-tunnel": "^0.2.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
